generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Task {
  id          String   @id @default(uuid())
  description String
  taskCodeId  String
  taskCode    TaskCode @relation(fields: [taskCodeId], references: [id])

  startDate DateTime
  endDate   DateTime

  status TASK_STATUS

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assignedToUserId String?
  assignedToUser   User?   @relation("AssignedToUser", fields: [assignedToUserId], references: [id])

  assignedToBatchId String?
  assignedToBatch   Batch?  @relation("AssignedToBatch", fields: [assignedToBatchId], references: [id])

  assignedToAcademyId String?
  assignedToAcademy   Academy? @relation("AssignedToAcademy", fields: [assignedToAcademyId], references: [id])

  studentQuizAttempts StudentQuizAttempt[]
  quizzes             Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model TaskCode {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  tasks Task[]

  @@map("task_codes")
}

enum TASK_STATUS {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  password    String?
  status      USER_STATUS @default(ACTIVE)
  mfaEnabled  Boolean     @default(false)
  lastLoginAt DateTime?

  assignedToAcademyId String?
  assignedToAcademy   Academy? @relation("AcademyUsers", fields: [assignedToAcademyId], references: [id])

  studentGoals       StudentWeeklyGoal[]
  invitationsCreated Invitation[]

  assignedTasks Task[] @relation("AssignedToUser")
  createdTasks  Task[] @relation("TaskCreatedBy")

  coachOfBatches   Batch[]   @relation("BatchCoaches")
  studentOfBatches Batch[]   @relation("BatchStudents")
  adminOfAcademies Academy[] @relation("AcademyAdmins")

  code String @unique

  subRole COACH_ROLE?
   emailVerificationTokens EmailVerificationToken[]

  friends  User[] @relation("UserFriends")
  friendOf User[] @relation("UserFriends")

  channels        Channel[]        @relation("ChannelMembers")
  ChannelMessages ChannelMessage[]
  notifications   Notification[]
  subscriptions   Subscription[]

  cartItems             CartItem[]
  studentProgramCredits StudentProgramCredit[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  createdEvents   Event[]            @relation("UserCreatedEvents")
  createdBatches  Batch[]            @relation("CreatedBatches")
  modifiedBatches Batch[]            @relation("ModifiedBatches")
  batchHistory    UserBatchHistory[]

  roleId  String
  role    Role     @relation(fields: [roleId], references: [id])
  profile Profile?

  createdQuizzes Quiz[]               @relation("QuizCreatedBy")
  quizAttempts   StudentQuizAttempt[]

  userSignup           UserSignup?
  studentSubscriptions StudentSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id           String    @id @default(uuid())
  firstName    String
  middleName   String?
  lastName     String
  dateOfBirth  DateTime? @default(now())
  phoneNumber  String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  parentName   String?
  parentEmail  String?
  chessComId   String?   @unique
  lichessId    String?
  uscfId       String?
  imageUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Academy {
  id   String  @id @default(uuid())
  name String
  logo String?

  admins  User[]  @relation("AcademyAdmins")
  batches Batch[]

  signupId String?        @unique
  signup   AcademySignup? @relation(fields: [signupId], references: [id])

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  subscriptions  Subscription[]
  purchasedPlans PurchasedPlan[]

  status        USER_STATUS @default(ACTIVE)
  assignedTasks Task[]      @relation("AssignedToAcademy")

  academyPlans AcademyProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSignups UserSignup[] @relation("AcademySignups")

  isDefault Boolean @default(false)
  signUpFee Float?

  usersAssigned User[] @relation("AcademyUsers")

  navigation AcademyNavigation[]

  pages Page[]

  domain        String?        @unique
  events        Event[]        @relation("AcademyEvents")
  notifications Notification[] @relation("AcademyNotifications")

  @@map("academies")
}

model Batch {
  id              String    @id @default(uuid())
  batchCode       String    @unique
  description     String?
  studentCapacity Int
  warningCutoff   Int
  currentClass    String
  startLevel      String
  currentLevel    String
  batchDay        String
  startTime       String
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean   @default(true)
  warningMailSent Boolean   @default(false)
  waitlistCount       Int       @default(0)


  academyId String
  academy   Academy @relation(fields: [academyId], references: [id])

  coaches  User[] @relation("BatchCoaches")
  students User[] @relation("BatchStudents")

  seasonalGoals SeasonalGoal[]
  monthlyGoals  MonthlyGoal[]
  weeklyGoals   WeeklyGoal[]
  assignedTasks Task[]         @relation("AssignedToBatch")
  channels      Channel[]
  messages      Message[]

  batchHistory    UserBatchHistory[]
  interestedUsers UserSignup[]       @relation("BatchInterest")

  createdBy      String
  createdByUser  User   @relation("CreatedBatches", fields: [createdBy], references: [id])
  modifiedBy     String
  modifiedByUser User   @relation("ModifiedBatches", fields: [modifiedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("batches")
}

model Invitation {
  id        String            @id @default(uuid())
  type      INVITATION_TYPE
  email     String            @unique
  data      Json?
  expiresAt DateTime?
  status    INVITATION_STATUS @default(PENDING)
  version   Int               @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  academySignupId String?        @unique
  academySignup   AcademySignup? @relation(fields: [academySignupId], references: [id], onDelete: SetNull)

  userSignupId String?     @unique
  userSignup   UserSignup? @relation(fields: [userSignupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

model Code {
  id    String @id @default(uuid())
  email String

  code String

  expiresAt DateTime

  type CODE_TYPE

  @@map("codes")
}

model Subscription {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  academyId String?
  academy   Academy? @relation(fields: [academyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Message {
  id             String   @id @default(uuid())
  senderId       String
  receiverId     String?
  content        String
  isRead         Boolean  @default(false)
  isReplyAllowed Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender   User  @relation("SentMessages", fields: [senderId], references: [id])
  receiver User? @relation("ReceivedMessages", fields: [receiverId], references: [id])

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id])

  @@map("messages")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  createdById String
  createdBy   User     @relation("UserCreatedEvents", fields: [createdById], references: [id])
  academyId   String
  academy     Academy  @relation("AcademyEvents", fields: [academyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[] @relation("EventNotifications")

  @@map("events")
}

model Notification {
  id      String  @id @default(uuid())
  userId  String
  message String
  isRead  Boolean @default(false)

  eventId String?
  event   Event?  @relation("EventNotifications", fields: [eventId], references: [id])

  academyId String?
  academy   Academy? @relation("AcademyNotifications", fields: [academyId], references: [id])

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model FriendRequest {
  id         String                @id @default(uuid())
  senderId   String
  receiverId String
  status     FRIEND_REQUEST_STATUS @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id])
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id])

  @@map("friend_requests")
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  isBroadcast Boolean  @default(false)
  batchId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch   Batch? @relation(fields: [batchId], references: [id])
  members User[] @relation("ChannelMembers")

  messages ChannelMessage[]

  @@map("channels")
}

model ChannelMessage {
  id        String   @id @default(uuid())
  channelId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id])
  sender  User    @relation(fields: [senderId], references: [id])

  @@map("channel_messages")
}

model StudentWeeklyGoal {
  id            String   @id @default(uuid())
  studentId     String
  weeklyGoalId  String
  puzzlesTarget Int?     @default(0)
  puzzlesSolved Int?     @default(0)
  puzzlesPassed Int?     @default(0)
  isCustom      Boolean  @default(false)
  createdAt     DateTime @default(now())

  student    User       @relation(fields: [studentId], references: [id])
  weeklyGoal WeeklyGoal @relation(fields: [weeklyGoalId], references: [id])

  @@map("studentweeklygoals")
}

model WeeklyGoal {
  id        String   @id @default(uuid())
  code      String
  startDate DateTime
  endDate   DateTime

  targetId String
  target   Target @relation(fields: [targetId], references: [id])

  monthlyGoalId String
  monthlyGoal   MonthlyGoal @relation(fields: [monthlyGoalId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  studentGoals StudentWeeklyGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("weeklygoals")
}

model Target {
  id         String @id @default(uuid())
  noOfGames  Int
  minReviews Int
  midReviews Int
  maxReviews Int

  weeklyGoals WeeklyGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("targets")
}

model MonthlyGoal {
  id        String   @id @default(uuid())
  code      String
  startDate DateTime
  endDate   DateTime

  seasonalGoalId String
  seasonalGoal   SeasonalGoal @relation(fields: [seasonalGoalId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  weeklyGoals WeeklyGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("monthlygoals")
}

model SeasonalGoal {
  id        String   @id @default(uuid())
  code      String
  startDate DateTime
  endDate   DateTime

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  monthlyGoals MonthlyGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seasonalgoals")
}

enum ROLE {
  SUPER_ADMIN
  ADMIN
  COACH
  STUDENT
  SUBSCRIBER
}

model Role {
  id              String           @id @default(uuid())
  name            ROLE             @unique
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Permission {
  id              String           @id @default(uuid())
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

enum GOAL_CATEGORY {
  GAMES
  PUZZLES
}

enum PLAN_TYPE {
  ACADEMY
  SUBSCRIBER
}

enum CODE_TYPE {
  FORGOT_PASSWORD
  LOGIN_WITHOUT_PASSWORD
}

enum INVITATION_TYPE {
  CREATE_ACADEMY
  BATCH_STUDENT
  BATCH_COACH
  USER_INVITATION
}

enum INVITATION_STATUS {
  PENDING
  ACCEPTED
  EXPIRED
  REJECTED
}

enum COACH_ROLE {
  HEAD_COACH
  SENIOR_COACH
  JUNIOR_COACH
  PUZZLE_MASTER
  PUZZLE_MASTER_SCHOLAR
}

enum FRIEND_REQUEST_STATUS {
  PENDING
  ACCEPTED
  REJECTED
}

enum USER_STATUS {
  ACTIVE
  INACTIVE
}

enum PAYMENT_STATUS {
  PENDING
  COMPLETED
  FAILED
}

model EmailVerification {
  id         String    @id @default(uuid())
  email      String
  otp        String
  type       CODE_TYPE
  expiresAt  DateTime
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, otp])
  @@map("email_verifications")
}

model UserBatchHistory {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id])
  fromDate  DateTime
  toDate    DateTime?
  reason    String?
  oldClass  String?
  newClass  String?
  oldLevel  String?
  newLevel  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("user_batch_history")
}

enum SYSTEM_CODE_MODULE {
  BATCH
  PLAN
  USER_SIGNUP
  USER
  ACADEMY_PROGRAM
  QUIZ
  QUIZ_QUESTION
}

model SystemCode {
  id          String             @id @default(uuid())
  module      SYSTEM_CODE_MODULE
  prefix      String
  description String?
  lastNumber  Int                @default(0)
  isActive    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([module, prefix])
  @@map("system_codes")
}

enum ACADEMY_SIGNUP_STATUS {
  INQUIRY
  DOMAIN_SELECTION
  PAYMENT_PENDING
  DOMAIN_VERIFICATION
  ACTIVE
  REJECTED
}

model Plan {
  id              String  @id @default(uuid())
  name            String
  maxUsers        Int
  academyPrice    Float
  subscriberPrice Float
  features        Json?
  isFeatured      Boolean @default(false)
  planId          String

  academies      Academy[]
  subscriptions  Subscription[]
  purchasedPlans PurchasedPlan[]
  academySignups AcademySignup[]

  academyStripePlanId    String @unique
  subscriberStripePlanId String @unique

  discountAllowed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model AcademyProgram {
  id          String           @id @default(uuid())
  name        String
  description String?
  type        PROGRAM_TYPE
  duration    PROGRAM_DURATION
  price       Float

  programId String @unique

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id])

  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  isSignUpFee Boolean @default(false)

  creditPoints Int?               @default(0)
  condition    PROGRAM_CONDITION?

  discountRules  Json?
  discountAmount Float?

  latePaymentFees Float?
  dueDate         DateTime?

  cartItems             CartItem[]
  studentSubscriptions  StudentSubscription[]
  studentProgramCredits StudentProgramCredit[]

  stripeProgramId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academy_programs")
}

model StudentProgramCredit {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  programId    String
  program      AcademyProgram @relation(fields: [programId], references: [id])
  pointsEarned Int            @default(0)
  attendance   Float?
  isRedeemed   Boolean        @default(false)
  redeemedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("student_program_credits")
}

model CartItem {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  programId       String
  program         AcademyProgram @relation(fields: [programId], references: [id])
  status          CART_STATUS    @default(PENDING)
  appliedCredit   Float?
  appliedDiscount Float?
  finalPrice      Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("cart_items")
}

enum PROGRAM_TYPE {
  P0
  P1
  P2
  P3
}

enum PROGRAM_DURATION {
  MONTHLY
  SEASONAL
}

enum PROGRAM_CONDITION {
  FULL_ATTENDANCE
  TOURNAMENT_WIN
  PARTICIPATION
  PERFORMANCE_IMPROVEMENT
}

enum CART_STATUS {
  PENDING
  COMPLETED
  CANCELLED
}

model AcademySignup {
  id          String  @id @default(uuid())
  academyName String
  contactName String
  email       String  @unique
  phoneNumber String
  logoUrl     String?

  selectedPlanId String?
  selectedPlan   Plan?   @relation(fields: [selectedPlanId], references: [id])

  requestedDomain String? @unique
  finalDomain     String? @unique

  status     ACADEMY_SIGNUP_STATUS @default(INQUIRY)
  statusNote String?

  invitation Invitation?

  paymentStatus PAYMENT_STATUS @default(PENDING)
  paymentAmount Float?
  paymentDate   DateTime?

  academy Academy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academy_signups")
}

enum SUBSCRIPTION_STATUS {
  ACTIVE
  CANCELLED
  EXPIRED
}

model StudentSubscription {
  id String @id @default(uuid())

  paymentStatus PAYMENT_STATUS @default(PENDING)

  autoRenew Boolean @default(false)

  lastBillingDate DateTime?
  nextBillingDate DateTime?

  userId               String
  user                 User                @relation(fields: [userId], references: [id])
  academyPlanId        String
  academyPlan          AcademyProgram      @relation(fields: [academyPlanId], references: [id])
  stripeSubscriptionId String?
  startDate            DateTime            @default(now())
  endDate              DateTime?
  status               SUBSCRIPTION_STATUS @default(ACTIVE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("student_subscriptions")
}

model PurchasedPlan {
  id String @id @default(uuid())

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  totalPrice Float

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchasedplans")
}

enum AUTH_TYPE {
  EMAIL_PASSWORD
  CHESS_COM
  CIC_ID
  MFA
}

model UserSignup {
  id           String             @id @default(uuid())
  email        String             @unique
  signupStage  REGISTRATION_STAGE @default(INQUIRY)
  signupStatus SIGNUP_STATUS      @default(INQUIRY)

  signupId String @unique

  firstName   String
  middleName  String?
  lastName    String
  userRole    ROLE
  coachType   COACH_ROLE?
  dateOfBirth DateTime
  parentName  String?
  parentEmail String?

  phoneNumber  String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  zipCode      String
 

  chessComId String? @unique
  lichessId  String?
  uscfId     String?
  cicId      String? @unique

  invitation Invitation?

  batchInterestId String?
  interestedBatch Batch?  @relation("BatchInterest", fields: [batchInterestId], references: [id])

  reservationTime   DateTime?
  reservationExpiry DateTime?
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean   @default(false)

  paymentStatus PAYMENT_STATUS @default(PENDING)
  paymentAmount Float?
  paymentDate   DateTime?

  academyId String?
  academy   Academy? @relation("AcademySignups", fields: [academyId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_signups")
}

enum REGISTRATION_STAGE {
  INQUIRY
  PRE_ACTIVATION
  PAYMENT
  POST_ACTIVATION
}

enum SIGNUP_STATUS {
  INQUIRY
  RESERVED
  WAITING
  CONFIRMED
}

// QUIZ TYPE

enum QUESTION_TYPE {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
  MATCHING
}

model Quiz {
  id           String  @id @default(uuid())
  quizCode     String  @unique
  title        String
  description  String?
  timeLimit    Int?
  passingScore Float?
  isActive     Boolean @default(true)

  questions QuizQuestion[]
  task      Task?           @relation(fields: [taskId], references: [id])
  taskId    String?

  createdById String
  createdBy   User   @relation("QuizCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quizzes")
}

model QuizQuestion {
  id            String        @id @default(uuid())
  questionCode  String        @unique
  questionText  String       
  type          QUESTION_TYPE
  marks         Float
  orderIndex    Int
  options       Json
  correctAnswer String

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  studentAnswers StudentQuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quiz_questions")
}

model StudentQuizAttempt {
  id        String      @id @default(uuid())
  startTime DateTime
  endTime   DateTime?
  score     Float?
  status    TASK_STATUS

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  answers StudentQuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_quiz_attempts")
}

model StudentQuizAnswer {
  id            String   @id @default(uuid())
  answerText    String   @db.Text
  isCorrect     Boolean?
  marksObtained Float?

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id])

  attemptId String
  attempt   StudentQuizAttempt @relation(fields: [attemptId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_quiz_answers")
}

model AcademyNavigation {
  id       String              @id @default(uuid())
  title    String
  slug     String
  order    Int
  isActive Boolean             @default(true)
  parentId String?
  parent   AcademyNavigation?  @relation("NavParentChild", fields: [parentId], references: [id])
  children AcademyNavigation[] @relation("NavParentChild")

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academyId, slug])
  @@map("academy_navigations")
}

enum PAGE_STATUS {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum COMPONENT_TYPE {
  PAGE_HEADER
  LEVEL_CARD
  CHESS_BATCH
  CONTACT_SECTION
  TEXT_BLOCK
  IMAGE_BLOCK
  HERO_SECTION
  PROGRAM_LIST
  TESTIMONIAL
  COACH_PROFILE
  NEWS_SECTION
  ACHIEVEMENT_SHOWCASE
  SEPARATOR
  SECTION_HEADER
}

model Page {
  id          String      @id @default(uuid())
  title       String
  slug        String
  description String?
  status      PAGE_STATUS @default(DRAFT)
  isHome      Boolean     @default(false)

  metaTitle       String?
  metaDescription String?

  academyId String
  academy   Academy @relation(fields: [academyId], references: [id])

  components PageComponent[]

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academyId, slug])
  @@map("pages")
}

model PageComponent {
  id    String         @id @default(uuid())
  type  COMPONENT_TYPE
  props Json 
  order Int

  pageId String
  page   Page   @relation(fields: [pageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("page_components")
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  userId     String
  newEmail   String
  token      String
  expiresAt  DateTime

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model SignupOTP  {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}